---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import { UI, CAT_LABEL, categorySlug, type Category, type Lang } from '../config';
import { getPosts } from '../lib/posts';

interface Props { lang: Lang; category: Category; }
const { lang, category } = Astro.props;
const ui = UI[lang];
const posts = (await getPosts(lang)).filter((p) => p.data.category === category);
---

<BaseLayout
  title={`${CAT_LABEL[lang][category]} — RPS Master Blog`}
  description={ui.categoryDesc(category)}
  lang={lang}
  i18nPath={`category/${categorySlug(category)}/`}
>
  <h1>{CAT_LABEL[lang][category]}</h1>
  {posts.length === 0 ? (
    <p class="lede">{ui.noPosts}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </ul>
  )}
</BaseLayout>
