---
import {
  SITE_URL, BASE, UI, CAT_LABEL, CATEGORIES, categorySlug,
  STUDIO_URL, STUDIO_URL_VI, PLAY_STORE_URL, CONTACT_EMAIL,
  type Lang,
} from '../config';
import { langPrefix } from '../lib/posts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
  // Path of this page inside the blog, identical in both languages:
  // '' for the home page, '<slug>/' for a post, 'category/<slug>/' for a category.
  i18nPath?: string;
}
const {
  title, description, image, type = 'website', jsonLd,
  lang = 'en', i18nPath = '',
} = Astro.props;
const ui = UI[lang];
const pageTitle = title ?? ui.siteTitle;
const pageDesc = description ?? ui.siteDescription;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ogImage = image ? new URL(image, Astro.site ?? SITE_URL).href : undefined;
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const enHref = `${BASE}/${i18nPath}`;
const viHref = `${BASE}/vi/${i18nPath}`;
const enUrl = `${SITE_URL}${enHref}`;
const viUrl = `${SITE_URL}${viHref}`;
const rssHref = `${BASE}${langPrefix(lang)}/rss.xml`;
const studioHref = lang === 'vi' ? STUDIO_URL_VI : STUDIO_URL;
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RPS Master Blog',
  url: `${SITE_URL}${BASE}${langPrefix(lang)}/`,
  inLanguage: lang === 'vi' ? 'vi-VN' : 'en',
  publisher: { '@type': 'Organization', name: 'BumStudio', url: STUDIO_URL },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="vi" href={viUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta name="robots" content="index, follow" />
    <link rel="alternate" type="application/rss+xml" title="RPS Master Blog" href={rssHref} />
    <link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="RPS Master Blog" />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${BASE}${langPrefix(lang)}/`}>RPS Master <span>Blog</span></a>
        <nav class="main">
          <a href={studioHref}>BumStudio</a>
          {CATEGORIES.map((c) => <a href={`${BASE}${langPrefix(lang)}/category/${categorySlug(c)}/`}>{CAT_LABEL[lang][c]}</a>)}
          <a class="btn-play" href={PLAY_STORE_URL} rel="noopener">{ui.getGame}</a>
          <span class="lang-switch">
            <a href={enHref} class={lang === 'en' ? 'active' : ''} hreflang="en">EN</a>
            <span aria-hidden="true">|</span>
            <a href={viHref} class={lang === 'vi' ? 'active' : ''} hreflang="vi">VI</a>
          </span>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          © {new Date().getFullYear()} BumStudio · <a href={studioHref}>bumstudio.net</a> ·
          <a href={rssHref}>RSS</a> · {ui.contact}: {CONTACT_EMAIL}
        </p>
      </div>
    </footer>
  </body>
</html>
