---
import GamePage from '../../components/GamePage.astro';
import { GAMES, type Game } from '../../config';

export function getStaticPaths() {
  return GAMES.map((game) => ({ params: { game }, props: { game } }));
}

const { game } = Astro.props as { game: Game };
---

<GamePage lang="en" game={game} />
